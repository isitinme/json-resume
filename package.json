{
  "name": "json-resume",
  "type": "module",
  "version": "0.0.3",
  "description": "My resume in JSON format. It is generated by jsonresume and rendered by jsonresume-theme-even.",
  "main": "src/index.ts",
  "engines": {
    "node": ">=25.0"
  },
  "packageManager": "npm@11.7.0",
  "scripts": {
    "start": "node src/index.ts",
    "validate:all": "node src/validate.ts",
    "typecheck": "tsc --noEmit",
    "pretty:check": "prettier --check .",
    "pretty:write": "prettier --write .",
    "prepare": "husky || true"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "jsonresume-theme-elegant-pink": "^0.1.5",
    "jsonresume-theme-even": "^0.22.0",
    "puppeteer": "^25.1.0",
    "resumed": "^3.0.1"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.71.2",
    "@types/node": "^26.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.2.1",
    "typescript": "^7.0.2"
  }
}
