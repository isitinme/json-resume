{
  "name": "json-resume",
  "type": "module",
  "version": "0.0.3",
  "description": "My resume in JSON format. It is generated by jsonresume and rendered by jsonresume-theme-even.",
  "main": "src/index.js",
  "engines": {
    "node": ">=25.0"
  },
  "packageManager": "npm@11.7.0",
  "scripts": {
    "pdf": "node src/index.js",
    "validate:all": "node src/validate.js",
    "pretty:check": "prettier --check",
    "pretty:write": "prettier --write",
    "prepare": "husky || true"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "jsonresume-theme-even": "^0.22.0",
    "puppeteer": "^25.1.0",
    "resumed": "^3.0.1"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.71.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.2.1"
  }
}
